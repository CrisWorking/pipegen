{
  "$schema": "http://json.schemastore.org/sarif-2.1.0",
  "runs": [
    {
      "defaultSourceLanguage": "dockerfile",
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {
                  "endColumn": 11,
                  "endLine": 3,
                  "sourceLanguage": "dockerfile",
                  "startColumn": 11,
                  "startLine": 3
                }
              }
            }
          ],
          "message": {
            "text": "unexpected end of line. At least two arguments are required for COPY"
          },
          "ruleId": "DL1000"
        }
      ],
      "tool": {
        "driver": {
          "downloadUri": "https://github.com/hadolint/hadolint",
          "fullName": "Haskell Dockerfile Linter",
          "name": "Hadolint",
          "shortDescription": {
            "text": "Dockerfile linter, validate inline bash, written in Haskell"
          },
          "version": "2.15.1"
        }
      }
    }
  ],
  "version": "2.1.0"
}
