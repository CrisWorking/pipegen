{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Trivy Vulnerability Scanner",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "name": "Trivy",
          "rules": [
            {
              "id": "acme/gpl:GPL-3.0-only",
              "name": "License",
              "shortDescription": {
                "text": "GPL-3.0-only in acme/gpl"
              },
              "fullDescription": {
                "text": "GPL-3.0-only in acme/gpl"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "License GPL-3.0-only\nClassification: restricted\nPkgName: acme/gpl\nPath: composer.lock",
                "markdown": "**License GPL-3.0-only**\n| PkgName | Classification | Path |\n| --- | --- | --- |\n|acme/gpl|restricted|composer.lock|"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "8.0",
                "tags": [
                  "license",
                  "security",
                  "HIGH"
                ]
              }
            },
            {
              "id": "acme/weird:SomeWeirdLicense-1.0",
              "name": "License",
              "shortDescription": {
                "text": "SomeWeirdLicense-1.0 in acme/weird"
              },
              "fullDescription": {
                "text": "SomeWeirdLicense-1.0 in acme/weird"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "License SomeWeirdLicense-1.0\nClassification: unknown\nPkgName: acme/weird\nPath: composer.lock",
                "markdown": "**License SomeWeirdLicense-1.0**\n| PkgName | Classification | Path |\n| --- | --- | --- |\n|acme/weird|unknown|composer.lock|"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "0.0",
                "tags": [
                  "license",
                  "security",
                  "UNKNOWN"
                ]
              }
            }
          ],
          "version": "0.76.0"
        }
      },
      "results": [
        {
          "ruleId": "acme/gpl:GPL-3.0-only",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Artifact: composer.lock\nLicense GPL-3.0-only\nPkgName: acme/gpl\n Classification: restricted\n Path: composer.lock"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "composer.lock",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              },
              "message": {
                "text": ""
              }
            }
          ]
        },
        {
          "ruleId": "acme/weird:SomeWeirdLicense-1.0",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "Artifact: composer.lock\nLicense SomeWeirdLicense-1.0\nPkgName: acme/weird\n Classification: unknown\n Path: composer.lock"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "composer.lock",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              },
              "message": {
                "text": ""
              }
            }
          ]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "originalUriBaseIds": {
        "ROOTPATH": {
          "uri": "file:///home/runner/work/fixture/fixture/"
        }
      }
    }
  ]
}
